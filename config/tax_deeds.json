  "lien_sources": {
    "_": "County clerk records are not reliably machine-readable, which is the whole reason this tool cannot certify title. Expect `unavailable` here and read it as `not screened`, never as `clean`.",
    "federal_tax_lien": {
      "check": "federal_tax_lien",
      "on_hit": "reject",
      "urls": {
        "Dallas": "https://dallas.tx.publicsearch.us/",
        "Tarrant": "https://tarrant.tx.publicsearch.us/",
        "Johnson": "https://johnson.tx.publicsearch.us/",
        "Ellis": "https://ellis.tx.publicsearch.us/"
      },
      "format": "clerk_search",
      "status": "unverified",
      "query_terms": [
        "FEDERAL TAX LIEN",
        "INTERNAL REVENUE",
        "UNITED STATES OF AMERICA"
      ]
    },
