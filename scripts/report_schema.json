{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Daily trade report",
  "type": "object",
  "required": [
    "date",
    "generated_at_et",
    "truncated",
    "market_context",
    "recommendations"
  ],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Report date in America/New_York"
    },
    "generated_at_et": {
      "type": "string",
      "description": "ISO-8601 timestamp with ET offset"
    },
    "research_minutes": {
      "type": [
        "number",
        "null"
      ],
      "description": "Wall-clock minutes the research phase actually got"
    },
    "truncated": {
      "type": "boolean",
      "description": "True when the research phase hit its hard timeout"
    },
    "pipeline_failure": {
      "type": "boolean",
      "default": false,
      "description": "Set only by ensure_report.py when synthesis produced nothing usable and this file is a stub. Fails the workflow so GitHub's default failure email fires, rather than a zero-idea day passing as green."
    },
    "data_quality_notes": {
      "type": "string",
      "description": "Honest account of what could not be verified, which sources failed, and why the idea count is what it is"
    },
    "market_context": {
      "type": "object",
      "required": [
        "summary",
        "regime"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "regime": {
          "type": "string",
          "enum": [
            "risk-on",
            "risk-off",
            "mixed",
            "unknown"
          ]
        },
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "description": "e.g. spx, ndx, vix, us10y, dxy, btc, wti, gold"
        },
        "econ_calendar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "datetime_et"
            ],
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string"
              },
              "datetime_et": {
                "type": "string"
              },
              "importance": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "consensus": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/idea"
      }
    },
    "watchlist": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string"
          },
          "instrument": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "What must happen before this becomes actionable"
          },
          "trigger": {
            "type": "string"
          },
          "demoted_from_rank": {
            "type": [
              "integer",
              "null"
            ]
          },
          "demotion_reason": {
            "type": "string"
          }
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": true,
      "description": "Written by validate_report.py: counts of passed, warned, and demoted ideas."
    },
    "last_refreshed_et": {
      "type": "string",
      "description": "When refresh_prices.py last re-quoted this report."
    },
    "last_refresh_session": {
      "type": "string",
      "description": "US equity session at the time of the last refresh."
    }
  },
  "definitions": {
    "idea": {
      "type": "object",
      "required": [
        "rank",
        "instrument",
        "symbol",
        "asset_class",
        "venue",
        "direction",
        "horizon",
        "conviction",
        "entry",
        "exit",
        "catalyst",
        "thesis",
        "key_risk",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "instrument": {
          "type": "string",
          "description": "Human-readable name"
        },
        "symbol": {
          "type": "string",
          "description": "Ticker, coin id, contract code, or event contract ticker"
        },
        "asset_class": {
          "type": "string",
          "enum": [
            "stock",
            "etf",
            "crypto",
            "futures",
            "event"
          ]
        },
        "venue": {
          "type": "string",
          "enum": [
            "Robinhood Stocks",
            "Robinhood Crypto",
            "Robinhood Derivatives",
            "Robinhood Prediction Markets"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "buy",
            "sell",
            "sell_short",
            "long",
            "short",
            "yes",
            "no"
          ]
        },
        "horizon": {
          "type": "string",
          "enum": [
            "intraday",
            "swing",
            "long_term"
          ]
        },
        "conviction": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "unit": {
          "type": "string",
          "enum": [
            "usd",
            "cents",
            "index_points"
          ],
          "default": "usd",
          "description": "cents for event contracts, index_points for index futures"
        },
        "last_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "last_price_asof": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry": {
          "type": "object",
          "required": [
            "ideal"
          ],
          "additionalProperties": false,
          "properties": {
            "ideal": {
              "type": [
                "number",
                "null"
              ]
            },
            "zone_low": {
              "type": [
                "number",
                "null"
              ]
            },
            "zone_high": {
              "type": [
                "number",
                "null"
              ]
            },
            "order_type": {
              "type": "string",
              "enum": [
                "limit",
                "market",
                "stop_limit",
                "on_open"
              ]
            },
            "condition": {
              "type": "string",
              "description": "e.g. only after CPI prints below consensus"
            }
          }
        },
        "exit": {
          "type": "object",
          "required": [
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": [
                "number",
                "null"
              ]
            },
            "target_2": {
              "type": [
                "number",
                "null"
              ]
            },
            "scale_plan": {
              "type": "string",
              "description": "e.g. trim 50% at target, trail the rest"
            },
            "time_stop": {
              "type": "string",
              "description": "Exit unconditionally by this date if neither level hits"
            }
          }
        },
        "stop": {
          "type": [
            "number",
            "null"
          ]
        },
        "bear_case_price": {
          "type": [
            "number",
            "null"
          ],
          "description": "Long-term downside anchor: what the asset is plausibly worth if the thesis is wrong. Required for long_term, where a hard stop is optional. Not an order to place."
        },
        "risk_reward": {
          "type": [
            "number",
            "null"
          ]
        },
        "win_probability": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Estimated probability the target is reached before the stop. Reward-to-risk alone says nothing about whether an idea makes money \u2014 3:1 at a 20% hit rate loses. validate_report.py compares this against 1/(1+R:R), the driftless random-walk probability, which is also the break-even hit rate; anything above it is the edge being claimed."
        },
        "validation": {
          "type": "object",
          "additionalProperties": true,
          "description": "Written by validate_report.py. Recomputed figures and check results; never authored by the model."
        },
        "position_size_pct": {
          "type": [
            "number",
            "null"
          ],
          "maximum": 5
        },
        "requires_margin": {
          "type": "boolean",
          "default": false
        },
        "catalyst": {
          "type": "object",
          "required": [
            "event",
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "type": "string",
              "description": "The specific dated thing that happens"
            },
            "datetime_et": {
              "type": [
                "string",
                "null"
              ]
            },
            "action": {
              "type": "string",
              "description": "How to orchestrate around it: enter before, wait for, trim into, avoid until"
            },
            "wait": {
              "type": "boolean",
              "default": false,
              "description": "True when the correct action today is to NOT enter yet"
            }
          }
        },
        "thesis": {
          "type": "string"
        },
        "key_risk": {
          "type": "string"
        },
        "counter_argument": {
          "type": "string",
          "description": "The strongest case against, from the falsification pass"
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "description": "The independent confirmations behind this idea, one entry each. Conviction is a count of these, not a feeling: validate_report.py checks the number of distinct `kind` values against the score claimed. Two entries of the same kind are one confirmation \u2014 three articles about one press release are one fact.",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "detail"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "dated_catalyst",
                  "primary_document",
                  "positioning",
                  "valuation_anchor",
                  "technical_level",
                  "counter_argument_answered"
                ],
                "description": "dated_catalyst: a scheduled event verified against a calendar, not claimed. primary_document: a filing, transcript or release actually read, not a summary of one. positioning: a measured flow or crowding read \u2014 insider buys, short interest, analyst revisions, options-implied move, relative strength. valuation_anchor: a defended number for what the asset is worth. technical_level: a level from real price history, not a round number. counter_argument_answered: the strongest case against, answered with evidence."
              },
              "detail": {
                "type": "string",
                "description": "What the confirmation actually is"
              },
              "source": {
                "type": "string",
                "description": "URL, where the confirmation has one"
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "market_cap_usd": {
          "type": [
            "number",
            "null"
          ],
          "description": "Used to apply the small-cap sizing cap and liquidity warnings."
        },
        "avg_dollar_volume": {
          "type": [
            "number",
            "null"
          ],
          "description": "Average daily dollar volume. The exit test for small caps."
        },
        "risk_tier": {
          "type": "string",
          "enum": [
            "lottery",
            "speculative",
            "standard",
            "high_conviction"
          ],
          "description": "Drives position sizing; see config/strategy.md."
        },
        "price_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "distance_to_entry_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "How far the live price sits from the ideal entry, as of the last refresh."
        }
      }
    }
  }
}
