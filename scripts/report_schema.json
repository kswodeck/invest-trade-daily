{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Daily trade report",
  "type": "object",
  "required": ["date", "generated_at_et", "truncated", "market_context", "recommendations"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Report date in America/New_York"
    },
    "generated_at_et": {
      "type": "string",
      "description": "ISO-8601 timestamp with ET offset"
    },
    "research_minutes": {
      "type": ["number", "null"],
      "description": "Wall-clock minutes the research phase actually got"
    },
    "truncated": {
      "type": "boolean",
      "description": "True when the research phase hit its hard timeout"
    },
    "pipeline_failure": {
      "type": "boolean",
      "default": false,
      "description": "Set only by ensure_report.py when synthesis produced nothing usable and this file is a stub. Fails the workflow so GitHub's default failure email fires, rather than a zero-idea day passing as green."
    },
    "data_quality_notes": {
      "type": "string",
      "description": "Honest account of what could not be verified, which sources failed, and why the idea count is what it is"
    },
    "market_context": {
      "type": "object",
      "required": ["summary", "regime"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "regime": { "type": "string", "enum": ["risk-on", "risk-off", "mixed", "unknown"] },
        "levels": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "null"] },
          "description": "e.g. spx, ndx, vix, us10y, dxy, btc, wti, gold"
        },
        "econ_calendar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event", "datetime_et"],
            "additionalProperties": false,
            "properties": {
              "event": { "type": "string" },
              "datetime_et": { "type": "string" },
              "importance": { "type": "string", "enum": ["high", "medium", "low"] },
              "consensus": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/definitions/idea" }
    },
    "watchlist": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["symbol", "note"],
        "additionalProperties": false,
        "properties": {
          "symbol": { "type": "string" },
          "instrument": { "type": "string" },
          "note": { "type": "string", "description": "What must happen before this becomes actionable" },
          "trigger": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "idea": {
      "type": "object",
      "required": [
        "rank", "instrument", "symbol", "asset_class", "venue", "direction",
        "horizon", "conviction", "entry", "exit", "catalyst", "thesis",
        "key_risk", "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "instrument": { "type": "string", "description": "Human-readable name" },
        "symbol": { "type": "string", "description": "Ticker, coin id, contract code, or event contract ticker" },
        "asset_class": { "type": "string", "enum": ["stock", "etf", "crypto", "futures", "event"] },
        "venue": {
          "type": "string",
          "enum": [
            "Robinhood Stocks",
            "Robinhood Crypto",
            "Robinhood Derivatives",
            "Robinhood Prediction Markets"
          ]
        },
        "direction": {
          "type": "string",
          "enum": ["buy", "sell", "sell_short", "long", "short", "yes", "no"]
        },
        "horizon": { "type": "string", "enum": ["intraday", "swing", "long_term"] },
        "conviction": { "type": "integer", "minimum": 1, "maximum": 5 },
        "unit": {
          "type": "string",
          "enum": ["usd", "cents", "index_points"],
          "default": "usd",
          "description": "cents for event contracts, index_points for index futures"
        },
        "last_price": { "type": ["number", "null"] },
        "last_price_asof": { "type": ["string", "null"] },
        "entry": {
          "type": "object",
          "required": ["ideal"],
          "additionalProperties": false,
          "properties": {
            "ideal": { "type": ["number", "null"] },
            "zone_low": { "type": ["number", "null"] },
            "zone_high": { "type": ["number", "null"] },
            "order_type": { "type": "string", "enum": ["limit", "market", "stop_limit", "on_open"] },
            "condition": { "type": "string", "description": "e.g. only after CPI prints below consensus" }
          }
        },
        "exit": {
          "type": "object",
          "required": ["target"],
          "additionalProperties": false,
          "properties": {
            "target": { "type": ["number", "null"] },
            "target_2": { "type": ["number", "null"] },
            "scale_plan": { "type": "string", "description": "e.g. trim 50% at target, trail the rest" },
            "time_stop": { "type": "string", "description": "Exit unconditionally by this date if neither level hits" }
          }
        },
        "stop": { "type": ["number", "null"] },
        "risk_reward": { "type": ["number", "null"] },
        "position_size_pct": { "type": ["number", "null"], "maximum": 5 },
        "requires_margin": { "type": "boolean", "default": false },
        "catalyst": {
          "type": "object",
          "required": ["event", "action"],
          "additionalProperties": false,
          "properties": {
            "event": { "type": "string", "description": "The specific dated thing that happens" },
            "datetime_et": { "type": ["string", "null"] },
            "action": {
              "type": "string",
              "description": "How to orchestrate around it: enter before, wait for, trim into, avoid until"
            },
            "wait": {
              "type": "boolean",
              "default": false,
              "description": "True when the correct action today is to NOT enter yet"
            }
          }
        },
        "thesis": { "type": "string" },
        "key_risk": { "type": "string" },
        "counter_argument": { "type": "string", "description": "The strongest case against, from the falsification pass" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
